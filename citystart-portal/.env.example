# CityStart Portal configuration (Baseline §2, §6)
#
# Copy to .env and adjust if you run services on non-default ports.
# No host or port may be hard-coded in business logic.

# Port the Portal listens on (Baseline §2: Portal = 3000)
PORT=3000

# API Gateway base URL. The Portal talks to this and nothing else (Baseline §5).
API_GATEWAY_URL=http://localhost:8000

# Seconds to wait for the Gateway before returning GATEWAY_TIMEOUT.
GATEWAY_TIMEOUT_SECONDS=30

# Set to 1 for Flask auto-reload during development. Leave 0 for the demo.
FLASK_DEBUG=0
